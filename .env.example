# ---- Shared ----
NODE_ENV=development
DATABASE_URL=postgresql://zuum:zuum@localhost:5432/zuum
REDIS_URL=redis://localhost:6379

# LiveKit (self-hosted dev server: `livekit-server --dev` uses devkey/secret)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- API ----
PORT=4000
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars-min
REQUIRE_EMAIL_VERIFICATION=false
# Also record one audio file per participant while recording is on.
RECORD_INDIVIDUAL_AUDIO=false
# S3-compatible storage for recordings (AWS S3, Cloudflare R2, MinIO).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=zuum-recordings
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# SMTP for password reset / verification. In development the mail is printed to the API log.
SMTP_URL=
MAIL_FROM=Zuum <no-reply@example.com>

# ---- Worker ----
# deepgram | mock (mock does not recognize speech; it emits labeled test segments)
STT_PROVIDER=deepgram
STT_LANGUAGE=id
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# anthropic | mock
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

# ---- Web (Vite) ----
VITE_API_URL=http://localhost:4000
