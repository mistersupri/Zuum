# ---- Shared ----
NODE_ENV=development
DATABASE_URL=postgresql://zuum:zuum@localhost:5432/zuum
REDIS_URL=redis://localhost:6379

# LiveKit (self-hosted dev server: `livekit-server --dev` uses devkey/secret)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- API ----
PORT=4000
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars-min
REQUIRE_EMAIL_VERIFICATION=false
# Also record one audio file per participant while recording is on.
RECORD_INDIVIDUAL_AUDIO=false
# S3-compatible storage for recordings. Free: the bundled MinIO. Low cost hosted: Cloudflare R2.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=zuum-recordings
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# SMTP for password reset / verification. In development the mail is printed to the API log.
SMTP_URL=
MAIL_FROM=Zuum <no-reply@example.com>

# ---- Worker ----
# Speech-to-text. whisper (default, free when self-hosted) | deepgram (paid streaming) | mock (tests only)
STT_PROVIDER=whisper
STT_LANGUAGE=id
# Any OpenAI-compatible /audio/transcriptions server: the bundled faster-whisper container,
# whisper.cpp, or a hosted Whisper API (then also set WHISPER_API_KEY).
WHISPER_BASE_URL=http://localhost:8000/v1
WHISPER_API_KEY=
WHISPER_MODEL=Systran/faster-whisper-small
# Re-transcribe ongoing speech every N ms to show partial text. 0 = off (least compute).
WHISPER_PARTIAL_INTERVAL_MS=0
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# AI minutes. ollama (default, free, self-hosted) | anthropic (Claude, paid) | mock (tests only)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
ANTHROPIC_API_KEY=
# Haiku is the low-cost Claude tier; use claude-sonnet-5-5 or claude-opus-5-5 for higher quality.
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=medium

# ---- Web (Vite) ----
VITE_API_URL=http://localhost:4000
